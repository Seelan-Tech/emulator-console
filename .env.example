# Configuration for Emulator Console. Copy to .env and edit. Lines starting with "# KEY=" are optional.

# ---- Core ----
# Directory holding the console's SQLite database (emulator-console.db). Created if missing. In Compose it is /data, on a volume. (default: ./data)
# DATA_DIR=./data
# At least 32 random characters. Encrypts target secrets at rest; rotating it invalidates stored target secrets. Required.
APP_SECRET=change-me-to-a-long-random-string-please
# Where the Help button in the header points. Unset, it opens the user guide of the version you run (its release tag on GitHub). Set it to your own copy of the guide if you keep one.
# DOCS_URL=https://docs.example.com/emulator-console
# Verbosity of server logs: debug, info, warn or error. (default: info)
# LOG_LEVEL=info

# ---- Access ----
# Extra Host header names the console accepts (comma-separated), besides localhost, 127.0.0.1 and [::1]. Requests with any other Host are refused (DNS-rebinding defence).
# LOCAL_ALLOWED_HOSTS=console.lan

# ---- Targets and credentials ----
# Let targets read the emulator's own credential files (restart detection depends on this). (default: false)
# ALLOW_LOCAL_CREDENTIAL_FILES=false
# Directory holding the emulator's per-port credential folders (mounted read-only). (default: /emu)
# LOCAL_CREDENTIALS_ROOT=/emu
# Endpoint of the Local emulator target the console creates by itself. Defaults to `https://emulator:<port>`.
# LOCAL_TARGET_ENDPOINT=https://emulator:9297
