{
  "name": "emulator-console",
  "version": "0.1.0",
  "description": "A local web console for use with the AWS Emulator: native service screens, recordable fixtures and restart recovery.",
  "author": "Seelan Technologies LLC <info@seelantech.com> (https://www.seelantech.com)",
  "homepage": "https://github.com/Seelan-Tech/emulator-console#readme",
  "bugs": "https://github.com/Seelan-Tech/emulator-console/issues",
  "keywords": [
    "aws",
    "emulator",
    "developer-tools",
    "testing",
    "nextjs"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seelan-Tech/emulator-console.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project components",
    "e2e": "scripts/e2e-stack.sh run local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "env:example": "tsx scripts/gen-env-example.ts",
    "notices": "node scripts/third-party-notices.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "test:watch": "vitest --project unit --project components",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --project integration",
    "e2e:restart": "scripts/e2e-stack.sh run restart",
    "e2e:live": "playwright test",
    "docs:screenshots": "scripts/e2e-stack.sh run local --config playwright.docs.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-kinesis": "^3.700.0",
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sfn": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@smithy/core": "^3.40.0",
    "@smithy/node-http-handler": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.33",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
